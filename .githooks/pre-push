#!/usr/bin/env bash
# Scan every commit about to be pushed (gitleaks: .gitleaks.toml for secrets,
# .gitleaks-personal.toml for personal data), so nothing reaches
# GitHub or Gitea that slipped past pre-commit (a merge, a commit made elsewhere).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

command -v gitleaks >/dev/null 2>&1 || {
  echo "pre-push: gitleaks is not installed (https://github.com/gitleaks/gitleaks)." >&2
  exit 1
}

zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a ref uploads nothing
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes" # new ref: only commits no remote has yet
  else
    range="$remote_sha..$local_sha"
  fi
  for config in .gitleaks.toml .gitleaks-personal.toml; do
    gitleaks git --log-opts="$range" --config "$config" --redact --no-banner || status=1
  done
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: gitleaks found secrets or personal data in the commits being pushed. Push aborted." >&2
fi
exit "$status"
